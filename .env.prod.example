# ---- Database ----
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=quote_wall_database

# ---- App ----
# Your public Cloudflare tunnel URL, e.g. https://quotes.yourdomain.com
NEXTAUTH_URL=https://your-tunnel-domain.com
NEXTAUTH_SECRET=  # generate with: openssl rand -base64 32

NEXT_PUBLIC_API_URL=https://your-tunnel-domain.com/api

# ---- Cloudflare Tunnel ----
# Create a tunnel at https://one.dash.cloudflare.com → Networks → Tunnels
# Point it to http://app:3000 (the app service name inside Docker)
# Copy the tunnel token shown in the dashboard
CLOUDFLARE_TUNNEL_TOKEN=
